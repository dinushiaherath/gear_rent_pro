<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="220.0" spacing="12" style="-fx-background-color: #214a26; -fx-padding: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gear_rent_pro.controller.SideMenuStaffController" stylesheets="@../../styles/global.css">
    <Label text="STAFF" textFill="WHITE">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>
    
    <Separator style="-fx-padding: 5 0 5 0;" />
    
    <Label text="Operations" textFill="WHITE" style="-fx-padding: 10 0 5 0;">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Label>
    <Button fx:id="btnEquipment" onAction="#loadEquipment" prefWidth="200.0" styleClass="side-button" text="📦 Equipments" />
    <Button fx:id="btnCustomers" onAction="#loadCustomers" prefWidth="200.0" styleClass="side-button" text="👥 Customers" />
    <Button fx:id="btnNewReservation" onAction="#loadReservation" prefWidth="200.0" styleClass="side-button" text="📋 Reservations" />
    <Button fx:id="btnNewRental" onAction="#loadRental" prefWidth="200.0" styleClass="side-button" text="🛒 Rentals" />
    
    <Label text="Settlements" textFill="WHITE" style="-fx-padding: 10 0 5 0;">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Label>
    <Button fx:id="btnOverdue" onAction="#loadOverdue" prefWidth="200.0" styleClass="side-button" text="⏰ Overdue Rentals" />
    
    <VBox VBox.vgrow="ALWAYS" />
    
    <Button fx:id="btnLogout" onAction="#logout" prefWidth="200.0" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8;" styleClass="btn-common" text="🚪 Logout" />
</VBox>
