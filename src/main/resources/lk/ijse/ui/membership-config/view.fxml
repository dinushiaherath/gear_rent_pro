<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gear_rent_pro.controller.MembershipConfigController" stylesheets="@../../styles/global.css">
    <TableView fx:id="table" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="colLevel" text="Membership Level" prefWidth="200.0" />
            <TableColumn fx:id="colDiscount" text="Discount (%)" prefWidth="200.0" />
        </columns>
    </TableView>
    <HBox spacing="10.0">
        <Button text="Save" onAction="#saveAll" styleClass="btn-common" />
    </HBox>
</VBox>
