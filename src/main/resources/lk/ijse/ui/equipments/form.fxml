<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="TOP_LEFT" style="-fx-padding:20; -fx-spacing:10;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gear_rent_pro.controller.EquipmentFormController" stylesheets="@../../styles/global.css">
    <Label text="Equipment" style="-fx-font-size:16; -fx-font-weight:bold;" />

    <HBox spacing="10">
        <Label text="Equipment ID:" />
        <TextField fx:id="equipmentIdField" editable="false" />
    </HBox>

    <HBox spacing="10">
        <Label text="Category:" />
        <ComboBox fx:id="categoryCombo" prefWidth="250" />
    </HBox>

    <HBox spacing="10">
        <Label text="Brand:" />
        <TextField fx:id="brandField" />
        <Label text="Model:" />
        <TextField fx:id="modelField" />
    </HBox>

    <HBox spacing="10">
        <Label text="Purchase Year:" />
        <TextField fx:id="yearField" prefWidth="80" />
        <Label text="Daily Price:" />
        <TextField fx:id="dailyPriceField" prefWidth="100" />
    </HBox>

    <HBox spacing="10">
        <Label text="Security Deposit:" />
        <TextField fx:id="depositField" prefWidth="100" />
        <Label text="Status:" />
        <ComboBox fx:id="statusCombo" />
    </HBox>

    <HBox spacing="10">
        <Label fx:id="branchLabel" text="Branch:" />
        <ComboBox fx:id="branchCombo" />
    </HBox>

    <HBox spacing="10">
        <Button text="Save" onAction="#onOk" styleClass="btn-common" />
        <Button text="Cancel" onAction="#onCancel" styleClass="btn-common" />
    </HBox>
</VBox>
