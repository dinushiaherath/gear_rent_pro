<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox prefHeight="480.0" prefWidth="820.0" spacing="12" style="-fx-padding:16;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gear_rent_pro.controller.EquipmentUtilizationController" stylesheets="@../../styles/global.css">
    <Label text="Equipment Utilization Report" style="-fx-font-size:20; -fx-font-weight:bold;" />
    <HBox spacing="8">
        <Label text="Branch:" />
        <ComboBox fx:id="branchCombo" prefWidth="220" />
        <Label text="From:" />
        <DatePicker fx:id="fromDate" />
        <Label text="To:" />
        <DatePicker fx:id="toDate" />
        <Button text="Generate" onAction="#generateReport" />
        <Button text="Refresh Branches" onAction="#refreshBranches" />
    </HBox>

    <TableView fx:id="utilTable" prefHeight="360" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn prefWidth="200" text="Equipment">
                <cellValueFactory>
                    <PropertyValueFactory property="equipmentDescription" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="120" text="Days Rented">
                <cellValueFactory>
                    <PropertyValueFactory property="daysRented" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="120" text="Days Available">
                <cellValueFactory>
                    <PropertyValueFactory property="daysAvailable" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="120" text="Utilization %">
                <cellValueFactory>
                    <PropertyValueFactory property="utilizationPercent" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
</VBox>
