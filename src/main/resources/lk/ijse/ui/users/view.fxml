<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="400.0" prefWidth="600.0" style="-fx-padding: 20; -fx-spacing: 15;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gear_rent_pro.controller.UserController" stylesheets="@../../styles/global.css">
    
    <Label text="User Management" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #214a26;" />
    
    <HBox spacing="10.0">
        <Button text="Add" styleClass="btn-common" onAction="#showAddUserForm" />
        <Button text="Edit" styleClass="btn-common" onAction="#editUser" />
        <Button text="Delete" styleClass="btn-common" onAction="#deleteUser" />
        <Button text="Refresh" styleClass="btn-common" onAction="#refreshUserTable" />
    </HBox>
    <HBox spacing="10.0">
        <Label text="Search:" />
        <TextField fx:id="usernameSearchField" promptText="Username..." />
        <Label text="Role:" />
        <ComboBox fx:id="roleFilterCombo" prefWidth="150.0" />
        <Label text="Branch:" />
        <ComboBox fx:id="branchFilterCombo" prefWidth="180.0" />
        <Button text="Clear Filters" styleClass="btn-common" onAction="#clearFilters" />
    </HBox>
    
    <TableView fx:id="userTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn prefWidth="60.0" text="ID">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="120.0" text="Username">
                <cellValueFactory>
                    <PropertyValueFactory property="username" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="100.0" text="Role">
                <cellValueFactory>
                    <PropertyValueFactory property="role" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="100.0" text="Branch">
                <cellValueFactory>
                    <PropertyValueFactory property="branchId" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
    
</VBox>
