<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<GridPane fx:controller="lk.ijse.gear_rent_pro.controller.CustomerFormController" xmlns:fx="http://javafx.com/fxml" hgap="10" vgap="10" stylesheets="@../../styles/global.css">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>
    
    <Label text="Customer ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
    <TextField fx:id="customerIdField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

    <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

    <Label text="NIC/Passport:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
    <TextField fx:id="nicOrPassportField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

    <Label text="Contact No:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
    <TextField fx:id="contactNoField" GridPane.rowIndex="3" GridPane.columnIndex="1" />

    <Label text="Email:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
    <TextField fx:id="emailField" GridPane.rowIndex="4" GridPane.columnIndex="1" />

    <Label text="Address:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
    <TextField fx:id="addressField" GridPane.rowIndex="5" GridPane.columnIndex="1" />

    <Label text="Membership Level:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
    <ComboBox fx:id="membershipCombo" GridPane.rowIndex="6" GridPane.columnIndex="1" />

    <HBox spacing="10" GridPane.rowIndex="7" GridPane.columnIndex="1" alignment="CENTER_RIGHT">
        <Button text="OK" styleClass="btn-common" onAction="#onOk" />
        <Button text="Cancel" styleClass="btn-common" onAction="#onCancel" />
    </HBox>
</GridPane>
