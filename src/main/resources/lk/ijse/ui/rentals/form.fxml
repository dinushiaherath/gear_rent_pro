<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="500.0" prefWidth="600.0" style="-fx-padding: 20; -fx-spacing: 15;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gear_rent_pro.controller.RentalFormController" stylesheets="@../../styles/global.css">
    
    <Label text="Create New Rental" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #214a26;" />
    
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <javafx.scene.layout.ColumnConstraints percentWidth="50.0" />
            <javafx.scene.layout.ColumnConstraints percentWidth="50.0" />
        </columnConstraints>
        
        <!-- Rental ID (read-only) -->
        <Label text="Rental ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="rentalIdField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <!-- Branch (read-only for non-admins) -->
        <Label text="Branch:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="branchCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        
        <!-- Customer Selection -->
        <Label text="Customer:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="customerCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        
        <!-- Start Date -->
        <Label text="Start Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <DatePicker fx:id="startDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        
        <!-- End Date -->
        <Label text="End Date:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <DatePicker fx:id="endDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Equipment Selection (placed after dates so branch+dates drive available list) -->
        <Label text="Equipment:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <ComboBox fx:id="equipmentCombo" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        
        <!-- Daily Rate (read-only) -->
        <Label text="Daily Rate:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="dailyRateField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        
        <!-- Rental Duration (read-only) -->
        <Label text="Duration (days):" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <TextField fx:id="durationField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="7" />
        
        <!-- Base Rental Amount (read-only) -->
        <Label text="Base Rental Amount:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
        <TextField fx:id="baseAmountField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="8" />
        
        <!-- Membership Discount (read-only) -->
        <Label text="Membership Discount:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
        <TextField fx:id="membershipDiscountField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="9" />
        
        <!-- Long Rental Discount (read-only) -->
        <Label text="Long Rental Discount:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
        <TextField fx:id="longRentalDiscountField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="10" />
        
        <!-- Final Amount (read-only) -->
        <Label text="Final Amount:" GridPane.columnIndex="0" GridPane.rowIndex="11" />
        <TextField fx:id="finalAmountField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="11" />
        
        <!-- Security Deposit (read-only) -->
        <Label text="Security Deposit:" GridPane.columnIndex="0" GridPane.rowIndex="12" />
        <TextField fx:id="securityDepositField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="12" />
    </GridPane>

    <!-- Pricing Breakdown Section -->
    <Label text="Pricing Breakdown" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #214a26;" />
    <ScrollPane fitToWidth="true" prefHeight="300.0" style="-fx-border-color: #ddd; -fx-border-radius: 5;">
        <TextArea fx:id="breakdownArea" editable="false" wrapText="true" style="-fx-font-family: monospace; -fx-font-size: 11; -fx-padding: 10;" />
    </ScrollPane>
    
    <!-- Action Buttons -->
    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Create Rental" styleClass="btn-common" onAction="#createRental" />
        <Button text="Cancel" styleClass="btn-common" onAction="#cancelForm" />
    </HBox>
    
</VBox>
